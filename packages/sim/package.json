{
  "name": "@vector3d/sim",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, DOM-free simulation of a Tower of Tribute 3D Run.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "harness": "node --import ./harness/loader.ts harness/cli.ts",
    "tune-frost": "node --import ./harness/loader.ts harness/tune-frost.ts"
  }
}
